# ============================================
# NuAIg Chronos - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose this to the browser.
# Used server-side only (Next.js API routes) for admin operations
# such as creating users via supabase.auth.admin.createUser().
# Get it from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
